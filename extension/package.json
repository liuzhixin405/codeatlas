{
  "name": "codetrail-graph",
  "displayName": "CodeTrail Graph",
  "description": "%description%",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuzhixin405/CodeAtlas.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/liuzhixin405/CodeAtlas#readme",
  "bugs": {
    "url": "https://github.com/liuzhixin405/CodeAtlas/issues"
  },
  "keywords": [
    "call graph",
    "code navigation",
    "architecture",
    "impact analysis",
    "code map"
  ],
  "galleryBanner": {
    "color": "#102438",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "cytoscape-elk": "2.3.0",
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.9",
    "@types/node": "22.15.0",
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "@vscode/vsce": "4.0.0"
  },
  "publisher": "164910441",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:csharp",
    "onLanguage:go",
    "onLanguage:python",
    "onLanguage:java"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeatlas.showSymbol",
        "title": "%command.showSymbol%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.openPanel",
        "title": "%command.openPanel%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.indexWorkspace",
        "title": "%command.indexWorkspace%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.indexWorkspaceFull",
        "title": "%command.indexWorkspaceFull%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.restartServer",
        "title": "%command.restartServer%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.ai.selectService",
        "title": "%command.ai.selectService%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.ai.setApiKey",
        "title": "%command.ai.setApiKey%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.ai.clearApiKey",
        "title": "%command.ai.clearApiKey%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.outline.pin",
        "title": "%command.outline.pin%",
        "category": "CodeTrail Graph",
        "icon": "$(pin)"
      },
      {
        "command": "codeatlas.outline.unpin",
        "title": "%command.outline.unpin%",
        "category": "CodeTrail Graph",
        "icon": "$(pinned)"
      },
      {
        "command": "codeatlas.outline.hideExternals",
        "title": "%command.outline.hideExternals%",
        "category": "CodeTrail Graph",
        "icon": "$(filter)"
      },
      {
        "command": "codeatlas.outline.showExternals",
        "title": "%command.outline.showExternals%",
        "category": "CodeTrail Graph",
        "icon": "$(filter-filled)"
      },
      {
        "command": "codeatlas.outline.openInPanel",
        "title": "%command.outline.openInPanel%",
        "category": "CodeTrail Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codeatlas.outline.refresh",
        "title": "%command.outline.refresh%",
        "category": "CodeTrail Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "codeatlas.outline.goToDefinition",
        "title": "%command.outline.goToDefinition%",
        "category": "CodeTrail Graph",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codeatlas.outline.open",
        "title": "%command.outline.open%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.impact.pin",
        "title": "%command.impact.pin%",
        "category": "CodeTrail Graph",
        "icon": "$(pin)"
      },
      {
        "command": "codeatlas.impact.unpin",
        "title": "%command.impact.unpin%",
        "category": "CodeTrail Graph",
        "icon": "$(pinned)"
      },
      {
        "command": "codeatlas.impact.includeTests",
        "title": "%command.impact.includeTests%",
        "category": "CodeTrail Graph",
        "icon": "$(beaker)"
      },
      {
        "command": "codeatlas.impact.excludeTests",
        "title": "%command.impact.excludeTests%",
        "category": "CodeTrail Graph",
        "icon": "$(beaker-stop)"
      },
      {
        "command": "codeatlas.impact.openInPanel",
        "title": "%command.impact.openInPanel%",
        "category": "CodeTrail Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codeatlas.impact.refresh",
        "title": "%command.impact.refresh%",
        "category": "CodeTrail Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "codeatlas.impact.goToDefinition",
        "title": "%command.impact.goToDefinition%",
        "category": "CodeTrail Graph",
        "icon": "$(go-to-file)"
      },
      {
        "command": "codeatlas.impact.open",
        "title": "%command.impact.open%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.impact.showFor",
        "title": "%command.impact.showFor%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.gotoCallers",
        "title": "%command.gotoCallers%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.gotoCallees",
        "title": "%command.gotoCallees%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.gotoEntries",
        "title": "%command.gotoEntries%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.showRelations",
        "title": "%command.showRelations%",
        "category": "CodeTrail Graph"
      },
      {
        "command": "codeatlas.outline.openRelations",
        "title": "%command.outline.openRelations%",
        "category": "CodeTrail Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "codeatlas.impact.openRelations",
        "title": "%command.impact.openRelations%",
        "category": "CodeTrail Graph",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "codeatlas.impact.analyzeChanges",
        "title": "%command.impact.analyzeChanges%",
        "category": "CodeTrail Graph",
        "icon": "$(git-compare)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeatlas",
          "title": "CodeTrail Graph",
          "icon": "webview/icon.svg"
        }
      ]
    },
    "views": {
      "codeatlas": [
        {
          "id": "codeatlas.callOutline",
          "name": "%view.callOutline%",
          "icon": "webview/icon.svg",
          "contextualTitle": "CodeTrail Graph"
        },
        {
          "id": "codeatlas.impact",
          "name": "%view.impact%",
          "icon": "webview/icon.svg",
          "contextualTitle": "CodeTrail Graph"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeatlas.callOutline",
        "contents": "%welcome.callOutline.noIndex%",
        "when": "codeatlas.outline.state == noIndex"
      },
      {
        "view": "codeatlas.callOutline",
        "contents": "%welcome.callOutline.noMethod%",
        "when": "!codeatlas.outline.state || codeatlas.outline.state == noMethod"
      },
      {
        "view": "codeatlas.callOutline",
        "contents": "%welcome.callOutline.noServer%",
        "when": "codeatlas.outline.state == noServer"
      },
      {
        "view": "codeatlas.callOutline",
        "contents": "%welcome.callOutline.error%",
        "when": "codeatlas.outline.state == error"
      },
      {
        "view": "codeatlas.impact",
        "contents": "%welcome.impact.noIndex%",
        "when": "codeatlas.impact.state == noIndex"
      },
      {
        "view": "codeatlas.impact",
        "contents": "%welcome.impact.noMethod%",
        "when": "!codeatlas.impact.state || codeatlas.impact.state == noMethod"
      },
      {
        "view": "codeatlas.impact",
        "contents": "%welcome.impact.noServer%",
        "when": "codeatlas.impact.state == noServer"
      },
      {
        "view": "codeatlas.impact",
        "contents": "%welcome.impact.error%",
        "when": "codeatlas.impact.state == error"
      }
    ],
    "submenus": [
      {
        "id": "codeatlas.editorContext",
        "label": "CodeTrail Graph"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "codeatlas.editorContext",
          "group": "0_codeatlas@1",
          "when": "editorTextFocus"
        }
      ],
      "codeatlas.editorContext": [
        {
          "command": "codeatlas.showSymbol",
          "group": "1_view@1"
        },
        {
          "command": "codeatlas.showRelations",
          "group": "1_view@2"
        },
        {
          "command": "codeatlas.gotoCallers",
          "group": "2_jump@1"
        },
        {
          "command": "codeatlas.gotoCallees",
          "group": "2_jump@2"
        },
        {
          "command": "codeatlas.gotoEntries",
          "group": "2_jump@3"
        }
      ],
      "commandPalette": [
        {
          "command": "codeatlas.showSymbol",
          "when": "editorIsOpen"
        },
        {
          "command": "codeatlas.outline.pin",
          "when": "!codeatlas.outline.pinned"
        },
        {
          "command": "codeatlas.outline.unpin",
          "when": "codeatlas.outline.pinned"
        },
        {
          "command": "codeatlas.outline.hideExternals",
          "when": "codeatlas.outline.externals"
        },
        {
          "command": "codeatlas.outline.showExternals",
          "when": "!codeatlas.outline.externals"
        },
        {
          "command": "codeatlas.outline.goToDefinition",
          "when": "false"
        },
        {
          "command": "codeatlas.outline.open",
          "when": "false"
        },
        {
          "command": "codeatlas.impact.pin",
          "when": "!codeatlas.impact.pinned"
        },
        {
          "command": "codeatlas.impact.unpin",
          "when": "codeatlas.impact.pinned"
        },
        {
          "command": "codeatlas.impact.includeTests",
          "when": "!codeatlas.impact.tests"
        },
        {
          "command": "codeatlas.impact.excludeTests",
          "when": "codeatlas.impact.tests"
        },
        {
          "command": "codeatlas.impact.openInPanel",
          "when": "false"
        },
        {
          "command": "codeatlas.impact.goToDefinition",
          "when": "false"
        },
        {
          "command": "codeatlas.impact.open",
          "when": "false"
        },
        {
          "command": "codeatlas.impact.showFor",
          "when": "false"
        },
        {
          "command": "codeatlas.gotoCallers",
          "when": "editorIsOpen"
        },
        {
          "command": "codeatlas.gotoCallees",
          "when": "editorIsOpen"
        },
        {
          "command": "codeatlas.gotoEntries",
          "when": "editorIsOpen"
        },
        {
          "command": "codeatlas.showRelations",
          "when": "editorIsOpen"
        },
        {
          "command": "codeatlas.outline.openRelations",
          "when": "false"
        },
        {
          "command": "codeatlas.impact.openRelations",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "codeatlas.outline.pin",
          "when": "view == codeatlas.callOutline && !codeatlas.outline.pinned",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.outline.unpin",
          "when": "view == codeatlas.callOutline && codeatlas.outline.pinned",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.outline.hideExternals",
          "when": "view == codeatlas.callOutline && codeatlas.outline.externals",
          "group": "navigation@2"
        },
        {
          "command": "codeatlas.outline.showExternals",
          "when": "view == codeatlas.callOutline && !codeatlas.outline.externals",
          "group": "navigation@2"
        },
        {
          "command": "codeatlas.outline.openInPanel",
          "when": "view == codeatlas.callOutline",
          "group": "navigation@3"
        },
        {
          "command": "codeatlas.outline.refresh",
          "when": "view == codeatlas.callOutline",
          "group": "navigation@4"
        },
        {
          "command": "codeatlas.impact.pin",
          "when": "view == codeatlas.impact && !codeatlas.impact.pinned",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.impact.unpin",
          "when": "view == codeatlas.impact && codeatlas.impact.pinned",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.impact.includeTests",
          "when": "view == codeatlas.impact && !codeatlas.impact.tests",
          "group": "navigation@2"
        },
        {
          "command": "codeatlas.impact.excludeTests",
          "when": "view == codeatlas.impact && codeatlas.impact.tests",
          "group": "navigation@2"
        },
        {
          "command": "codeatlas.impact.openInPanel",
          "when": "view == codeatlas.impact",
          "group": "navigation@3"
        },
        {
          "command": "codeatlas.impact.refresh",
          "when": "view == codeatlas.impact",
          "group": "navigation@4"
        },
        {
          "command": "codeatlas.outline.openRelations",
          "when": "view == codeatlas.callOutline",
          "group": "navigation@3"
        },
        {
          "command": "codeatlas.impact.openRelations",
          "when": "view == codeatlas.impact",
          "group": "navigation@3"
        },
        {
          "command": "codeatlas.impact.analyzeChanges",
          "when": "view == codeatlas.impact",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "codeatlas.outline.goToDefinition",
          "when": "view == codeatlas.callOutline && viewItem =~ /target/",
          "group": "inline"
        },
        {
          "command": "codeatlas.outline.goToDefinition",
          "when": "view == codeatlas.callOutline && viewItem =~ /target/",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.impact.goToDefinition",
          "when": "view == codeatlas.impact && viewItem =~ /target/",
          "group": "inline"
        },
        {
          "command": "codeatlas.impact.goToDefinition",
          "when": "view == codeatlas.impact && viewItem =~ /target/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codeatlas.showSymbol",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "codeatlas.gotoCallers",
        "key": "ctrl+alt+h",
        "mac": "ctrl+cmd+h",
        "when": "editorTextFocus && resourceScheme == file && resourceExtname =~ /^\\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|cs|go|py|java)$/i"
      },
      {
        "command": "codeatlas.gotoCallees",
        "key": "ctrl+alt+j",
        "mac": "ctrl+cmd+j",
        "when": "editorTextFocus && resourceScheme == file && resourceExtname =~ /^\\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|cs|go|py|java)$/i"
      },
      {
        "command": "codeatlas.gotoEntries",
        "key": "ctrl+alt+r",
        "mac": "ctrl+cmd+r",
        "when": "editorTextFocus && resourceScheme == file && resourceExtname =~ /^\\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|cs|go|py|java)$/i"
      }
    ],
    "configuration": {
      "title": "CodeTrail Graph",
      "properties": {
        "codeatlas.serverPath": {
          "type": "string",
          "default": "",
          "description": "%config.serverPath.description%"
        },
        "codeatlas.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.ai.enabled.description%",
          "order": 0
        },
        "codeatlas.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ],
          "enumDescriptions": [
            "%config.ai.provider.enum0%",
            "%config.ai.provider.enum1%"
          ],
          "default": "openai",
          "markdownDescription": "%config.ai.provider.markdownDescription%",
          "order": 1
        },
        "codeatlas.ai.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8080/v1",
          "markdownDescription": "%config.ai.endpoint.markdownDescription%",
          "order": 2
        },
        "codeatlas.ai.model": {
          "type": "string",
          "default": "qwen3.6-27b",
          "markdownDescription": "%config.ai.model.markdownDescription%",
          "order": 3
        },
        "codeatlas.ai.concurrency": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 8,
          "description": "%config.ai.concurrency.description%",
          "order": 4
        },
        "codeatlas.ai.timeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 10,
          "description": "%config.ai.timeoutSeconds.description%",
          "order": 5
        },
        "codeatlas.ai.includeSource": {
          "type": "boolean",
          "default": true,
          "description": "%config.ai.includeSource.description%",
          "order": 6
        },
        "codeatlas.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.projects.markdownDescription%"
        },
        "codeatlas.includeNestedRepos": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.includeNestedRepos.markdownDescription%"
        },
        "codeatlas.indexOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.indexOnSave.description%"
        },
        "codeatlas.indexOnExternalChange": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.indexOnExternalChange.markdownDescription%"
        },
        "codeatlas.externalChangeDebounceMs": {
          "type": "number",
          "default": 2000,
          "minimum": 200,
          "markdownDescription": "%config.externalChangeDebounceMs.markdownDescription%"
        },
        "codeatlas.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.enabled.markdownDescription%"
        }
      }
    }
  }
}
